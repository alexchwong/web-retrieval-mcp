# Copy this file to .env before starting the stack.
# Generate a secret with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-secret

# Optional host-facing settings.
SEARXNG_BIND_ADDRESS=127.0.0.1
SEARXNG_HOST_PORT=8888
SEARXNG_BASE_URL=http://localhost:8888/
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST_PORT=8765

# Optional container sizing and MCP identity (changes require a restart).
UWSGI_WORKERS=2
UWSGI_THREADS=2
# The default name is webspell; set web-retrieval to keep the 0.1.1 name.
MCP_SERVER_NAME=webspell

# Request guard (changes require a restart). Loopback hosts and origins and the
# Compose service name web-retrieval are always accepted. Add comma-separated
# Host names (for example a LAN name) or browser origins (scheme://host:port).
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Research behavior is configured in docker/settings.toml.
