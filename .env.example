# Copy this file to .env before starting the stack.
# Generate a secret with: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-secret

# Optional host-facing settings.
SEARXNG_BIND_ADDRESS=127.0.0.1
SEARXNG_HOST_PORT=8888
SEARXNG_BASE_URL=http://localhost:8888/
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST_PORT=8765

# Optional container sizing and MCP identity (changes require a restart).
UWSGI_WORKERS=2
UWSGI_THREADS=2
MCP_SERVER_NAME=web-retrieval

# Research behavior is configured in web-retrieval/settings.toml.
